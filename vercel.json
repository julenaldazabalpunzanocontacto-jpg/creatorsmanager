{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/xturbo",
      "destination": "/creadores/xturbo",
      "permanent": true
    },
    {
      "source": "/dagar",
      "destination": "/creadores/dagar",
      "permanent": true
    },
    {
      "source": "/arsel",
      "destination": "/creadores/arsel",
      "permanent": true
    },
    {
      "source": "/danomc",
      "destination": "/creadores/danomc",
      "permanent": true
    },
    {
      "source": "/marzy",
      "destination": "/creadores/marzy",
      "permanent": true
    },
    {
      "source": "/mateo",
      "destination": "/creadores/mateo",
      "permanent": true
    },
    {
      "source": "/magagames",
      "destination": "/creadores/magagames",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}